# Nhà cung cấp LLM qua API tương thích OpenAI. Đổi 3 dòng này là đổi hãng.
# Mặc định: Gemini (free tier 20 request/phút).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=your_api_key_here

# Ví dụ chuyển sang Groq (free, KHÔNG cần thẻ tín dụng, tạo key tại console.groq.com):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=<key Groq của bạn>

# (tương thích ngược - nếu không đặt LLM_API_KEY thì lấy khoá này)
GEMINI_API_KEY=your_gemini_api_key_here
